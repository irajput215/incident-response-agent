# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
#   cp .env.example .env
#
# EVERY value below is optional. With an empty file the system still starts and
# the full test suite + agent evaluation suite still pass, because every
# key-dependent path degrades to a deterministic offline stub. Check what the
# running system actually thinks it has with:  curl localhost:8000/health
# =============================================================================

# --- application -------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# structured JSON logs to stderr (true) or human-readable console logs (false)
LOG_JSON=true

# --- LLM (provider-agnostic, via LiteLLM) ------------------------------------
# Leave LLM_MODEL empty to run the deterministic stub: no network, no cost,
# no API key. This is what CI uses.
#
# LiteLLM model strings look like "<provider>/<model>". Examples:
#   LLM_MODEL=anthropic/claude-sonnet-4-5
#   LLM_MODEL=openai/gpt-4o-mini
#   LLM_MODEL=deepseek/deepseek-chat
#   LLM_MODEL=ollama/qwen2.5:7b            (local, free — needs `ollama pull`)
LLM_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# Per-incident ceiling, enforced in the agent loop. Exceeding it fails the run
# rather than silently spending more.
LLM_MAX_CALLS_PER_INCIDENT=25

# Provider API keys — only the one matching LLM_MODEL is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Only for LLM_MODEL=ollama/... — the local Ollama server.
OLLAMA_API_BASE=http://localhost:11434

# --- LangSmith: tracing + evaluation -----------------------------------------
# Set both to enable. With LANGSMITH_TRACING unset, tracing is a no-op and the
# evaluation suite still runs (it just reports locally instead of uploading).
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-incident-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- PostgreSQL ---------------------------------------------------------------
# Local Homebrew Postgres needs no password and trusts localhost.
DATABASE_URL=postgresql://irajput@localhost:5432/ai_incidents
# Applied on startup; keeps the dev database reproducible.
DB_AUTO_MIGRATE=true
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- simulated pipeline estate ------------------------------------------------
# Where the fake S3 / ETL artifacts and pipeline logs live on disk.
# Phase 1 reads the local filesystem; the same interface can be backed by S3.
PIPELINE_LOG_DIR=data/logs
PIPELINE_ESTATE_FILE=data/estate.json
# Set to use real S3 instead of the local filesystem simulation.
S3_BUCKET=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- serving ------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Hard server-side cap on rows returned by any dataset endpoint.
API_MAX_ROWS=1000
